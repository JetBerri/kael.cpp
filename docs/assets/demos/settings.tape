# Shared terminal settings for the demo recordings. Sourced by the other tapes.

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 20
Set LineHeight 1.25
Set Width 1200
Set Padding 28
Set WindowBar Colorful
Set TypingSpeed 35ms
Set CursorBlink false
Set Framerate 30
Set Theme { "name": "kael", "background": "#0f1b2e", "foreground": "#dbe4f0", "cursor": "#6a82a8", "selection": "#2a3f63", "black": "#0f1b2e", "red": "#e27d7d", "green": "#8cc59a", "yellow": "#e6c97a", "blue": "#6a82a8", "magenta": "#b39ddb", "cyan": "#7fb7c9", "white": "#dbe4f0", "brightBlack": "#5b6b85", "brightRed": "#f09a9a", "brightGreen": "#a6d8b2", "brightYellow": "#f0d999", "brightBlue": "#8fa6cc", "brightMagenta": "#c9b6e8", "brightCyan": "#9fcfdd", "brightWhite": "#ffffff" }

Hide
Type `export PS1='\[\e[38;2;143;166;204m\]kael.cpp\[\e[0m\] $ '` Enter
Type "clear" Enter
Show
